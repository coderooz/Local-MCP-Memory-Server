{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentConfig",
  "type": "object",
  "required": [
    "agentName",
    "bootstrapFile",
    "mcpTransport"
  ],
  "properties": {
    "agentName": {
      "type": "string"
    },
    "bootstrapFile": {
      "type": "string"
    },
    "mcpTransport": {
      "type": "string",
      "enum": [
        "stdio",
        "sse"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
