# Database Configuration (Embedded SQLite — no external daemon required)
# Defaults to %LOCALAPPDATA%/local-mcp-memory/mcp-memory.db on Windows or ~/.local-mcp-memory/mcp-memory.db on Linux/macOS
# Set MCP_DB_PATH to specify an explicit path (e.g. for isolated testing or container volumes)
# MCP_DB_PATH=./data/mcp-memory.db

# Server Configuration
# Use 0 for dynamic port allocation (recommended to avoid conflicts), or specify fixed port (e.g. 3799)
PORT=0
MCP_BASE_PORT=47000
MCP_PORT_STRATEGY=dynamic

# MCP Project & Agent Identity
# Resolved in order: .mcp-project file > MCP_PROJECT env var > project directory basename
MCP_PROJECT=local-mcp-server
MCP_AGENT=codex
MCP_SCOPE=project
# MCP_PROJECT_ROOT=C:/path/to/project

# Node Environment & Logging
NODE_ENV=development
LOG_LEVEL=info
# MCP_DEBUG=false
# MCP_DEBUG_SQLITE=false

# Security & Secrets (Recommended for production)
# MCP_MASTER_SECRET: 32+ character passphrase used for AES-256-GCM encryption of stored upstream credentials
# MCP_MASTER_SECRET=your-32-char-min-master-secret-here
# JWT_SECRET: Secret for signing JWT authentication tokens on HTTP dashboard/API routes
# JWT_SECRET=your-jwt-secret-key-here
# JWT_EXPIRY=24h

# MCP Payload & Security Limits
# MCP_MAX_ARGUMENT_PAYLOAD_BYTES=1048576
# MCP_MAX_ARGUMENT_STRING_LENGTH=262144

# Notification Sound (Optional system alert)
# MCP_NOTIFICATION_SOUND_PATH=assets/alert.mp3

# Migration Settings (Used only by `local-mcp-memory migrate` CLI)
# MONGO_URI=mongodb://127.0.0.1:27017/mcp_memory
# MONGO_DB_NAME=mcp_memory

# Reset Confirmation (Required only for severe administrative resets)
# MCP_RESET_CONFIRM=your-confirmation-code
